FROM debian:bookworm-slim

LABEL image.author.name="paula"
LABEL image.author.email="yourmail"

# Install dependencies
RUN apt-get update && \
    apt-get install -y curl ca-certificates tar && \
    rm -rf /var/lib/apt/lists/*

# Download and install Salmon
RUN curl -L https://github.com/COMBINE-lab/salmon/releases/download/v1.5.2/salmon-1.5.2_linux_x86_64.tar.gz \
    -o salmon.tar.gz

RUN tar -xzf salmon.tar.gz && \
    mv salmon-1.5.2_linux_x86_64 /opt/salmon && \
    rm salmon.tar.gz

# Set the PATH environment variable (to /usr/bin)

ENV PATH="/opt/salmon/bin:${PATH}"
